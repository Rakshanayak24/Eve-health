# Copy this file to `.env` and adjust as needed for local development.

# Postgres connection string. When running via docker-compose, "db" is the
# service name of the Postgres container (see docker-compose.yml).
DATABASE_URL=postgresql://eve_user:eve_password@db:5432/eve_healthcare

# JWT signing secret - use a long random string in any real deployment.
JWT_SECRET_KEY=please-change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Shared secret the simulated payment provider must send back on webhook
# calls (as the `X-Webhook-Secret` header).
WEBHOOK_SHARED_SECRET=webhook_shared_secret_demo

# Probability (0-1) that a simulated payment succeeds when no force_status
# is supplied in the request.
PAYMENT_SUCCESS_RATE=0.8
